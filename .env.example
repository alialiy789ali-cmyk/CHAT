# ============================================================================
# Sovereign — environment template
# Copy to `.env` (root, for Docker Compose) and/or `apps/server/.env`.
# Every variable below is read by the server config validator (zod); unknown or
# malformed values fail fast at boot instead of misbehaving at runtime.
# NEVER commit a real .env — only this template.
# ============================================================================

# ---------------------------------------------------------------- runtime
NODE_ENV=development
APP_NAME=Sovereign
PORT=8787
HOST=0.0.0.0
# Public URL of the API as reached by browsers/mobile clients.
PUBLIC_API_URL=http://localhost:8787
# Comma separated list. Empty in development (the dev server reflects the origin);
# REQUIRED in production, e.g. https://chat.example.com
CORS_ORIGINS=
LOG_LEVEL=info

# ---------------------------------------------------------------- database
# Leave empty to auto-start an embedded PostgreSQL 16 (development only).
# Production MUST point at a managed/own PostgreSQL instance.
DATABASE_URL=
EMBEDDED_PG_PORT=54329
EMBEDDED_PG_DATA_DIR=var/pgdata
DATABASE_POOL_SIZE=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# ---------------------------------------------------------------- storage
# local = files on disk (var/storage) | s3 = MinIO/AWS S3 compatible
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=var/storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sovereign
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------- cache / queue
# memory = single process (development) | redis = multi-instance deployments
CACHE_DRIVER=memory
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------- mail
# console (dev, prints to stdout) | file (var/mail) | memory (tests) | smtp
MAIL_DRIVER=console
MAIL_FROM=Sovereign <no-reply@sovereign.local>
MAIL_OUTBOX_DIR=var/mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# ---------------------------------------------------------------- auth & secrets
# REQUIRED in production: each secret must be >= 32 characters of random data.
# Generate with: openssl rand -base64 48
# In development the server generates them under var/secrets/*.key automatically.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
REALTIME_TICKET_SECRET=
FIELD_ENCRYPTION_KEY=
SESSION_SECRET=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# Emails promoted to admin at registration (bootstrap the first operator).
ADMIN_EMAILS=
REQUIRE_EMAIL_VERIFICATION=false
# Closed deployment: signups require the code below.
REGISTRATION_INVITE_ONLY=false
REGISTRATION_INVITE_CODE=
MAX_ACTIVE_SESSIONS=10

# ---------------------------------------------------------------- realtime
WS_MAX_CONNECTIONS_PER_USER=5
WS_MAX_FRAME_BYTES=262144

# ---------------------------------------------------------------- WebRTC calls
# STUN/TURN. For a self-hosted deployment configure coturn (infra/coturn) and set:
#   RTC_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
#   RTC_TURN_SECRET=<same as static-auth-secret in turnserver.conf>
# TURN credentials are time-limited (HMAC) and issued per authenticated request.
RTC_ICE_SERVERS=stun:stun.l.google.com:19302
RTC_TURN_URLS=
RTC_TURN_USERNAME=
RTC_TURN_CREDENTIAL=
RTC_TURN_SECRET=
RTC_TURN_TTL_SECONDS=3600
# Optional SFU for group calls / live rooms (server returns 503 when unset — reported honestly).
RTC_LIVEKIT_URL=
RTC_LIVEKIT_API_KEY=
RTC_LIVEKIT_API_SECRET=

# ---------------------------------------------------------------- limits
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW=1 minute
UPLOAD_MAX_BYTES=52428800

# ---------------------------------------------------------------- end-to-end encryption
# FALSE by default on purpose: the Signal-protocol integration is not finished, and the
# server rejects ciphertext envelopes while it is disabled. Do not claim E2EE before this
# is flipped AND the key-management tests pass (see docs/security-report.md).
E2EE_ENABLED=false

# ---------------------------------------------------------------- web client (Next.js)
# Port the web app listens on; it proxies /api and /ws to the API server.
WEB_PORT=3000
# Where the web server finds the API (inside Compose: http://api:8787).
API_URL=http://localhost:8787

# ---------------------------------------------------------------- compose only
POSTGRES_USER=sovereign
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=sovereign
MINIO_ROOT_USER=sovereign
MINIO_ROOT_PASSWORD=change-me-in-production
# Public hostname used by coturn for the external-ip mapping and by nginx for TLS.
DOMAIN=localhost
