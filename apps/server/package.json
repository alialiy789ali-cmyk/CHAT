{
  "name": "@sovereign/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:up": "tsx scripts/db.ts up",
    "db:down": "tsx scripts/db.ts down",
    "db:status": "tsx scripts/db.ts status",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:reset": "tsx scripts/db.ts reset",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run --config vitest.config.ts --project unit",
    "test:watch": "vitest --config vitest.config.ts",
    "test:e2e": "vitest run --config vitest.config.ts --project e2e --no-file-parallelism",
    "test:all": "npm run test && npm run test:e2e",
    "smoke": "tsx scripts/smoke.ts",
    "sessions": "tsx scripts/sessions.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@sovereign/shared": "*",
    "embedded-postgres": "^16.14.0-beta.17",
    "fastify": "^5.12.7",
    "ioredis": "^5.8.2",
    "jose": "^6.2.12",
    "nodemailer": "^7.0.9",
    "otpauth": "^9.4.1",
    "pg": "^8.16.3",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@matrix-org/olm": "^3.2.15",
    "@signalapp/libsignal-client": "^0.105.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^7.0.3",
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
